{
  "snackPack": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('meta/hostUid').val() === auth.uid || data.child('meta/createdAt').val() < now - 21600000)",
        ".validate": "$room.length === 4",
        "meta": {
          "hostUid": { ".validate": "newData.isString() && newData.val().length < 64" },
          "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now + 120000" },
          "state": {
            ".write": "auth != null && data.parent().parent().child('players').child(auth.uid).exists()",
            ".validate": "newData.val() === 'garage' || newData.val() === 'started'"
          },
          "gameHost": {
            ".write": "auth != null && data.parent().parent().child('players').child(auth.uid).exists()",
            ".validate": "newData.isString() && newData.val().length < 64"
          },
          "gameGen": {
            ".write": "auth != null && data.parent().parent().child('players').child(auth.uid).exists()",
            ".validate": "newData.isNumber()"
          },
          "$other": { ".validate": false }
        },
        "rtc": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || data.parent().parent().child('meta/gameHost').val() === auth.uid)",
            "gen": { ".validate": "newData.isNumber()" },
            "offer": { ".validate": "newData.isString() && newData.val().length < 20000" },
            "answer": { ".validate": "newData.isString() && newData.val().length < 20000" },
            "$other": { ".validate": false }
          }
        },
        "slots": {
          "$slot": {
            ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
            ".validate": "$slot.matches(/^s[0-3]$/) && newData.val() === auth.uid"
          }
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
            "slot": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3" },
            "ready": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "creatures": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isString() && newData.val().length < 900000"
          }
        },
        "pings": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isNumber()"
          }
        }
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "creatures": {
          "$slot": {
            ".validate": "$slot.matches(/^s[0-5]$/) && newData.hasChildren(['t', 'json'])",
            "t": { ".validate": "newData.isNumber()" },
            "json": { ".validate": "newData.isString() && newData.val().length < 900000" },
            "$other": { ".validate": false }
          }
        },
        "$other": { ".validate": false }
      }
    },
    "shared": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists()",
        ".validate": "$code.length === 6 && newData.hasChildren(['owner', 't', 'json'])",
        "owner": { ".validate": "newData.val() === auth.uid" },
        "t": { ".validate": "newData.val() === now" },
        "json": { ".validate": "newData.isString() && newData.val().length < 900000" },
        "$other": { ".validate": false }
      }
    }
  }
}
